@using MVCEmpDept.Service
@using System.Collections

@model MVCEmpDept.Service.SqlEmployeeService 

@inject IEmployeeService context

<ol>
    @foreach(var empobj in context.GetAllEmployee())
    {        
        <li>@empobj.Name : @empobj.Email</li>
        @* <li>@empobj.Email </li> *@
    }
</ol>
