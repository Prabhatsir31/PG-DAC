@model IEnumerable<MVC.Models.Employee>

@{
    ViewData["Title"] = "Index";
}
<h1>Index</h1>
<p>
    <a asp-action="Create" class="btn-create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Department)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Department)
                </td>
                <td class="action-links">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="edit">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="details">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="delete">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>
